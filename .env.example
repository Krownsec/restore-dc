# Discord bot credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional: set to a single guild ID during development for instant slash command registration.
# Leave blank to register commands globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# Port for the keepalive web server (Render sets this automatically, but a default is provided)
PORT=3000

# Path to the SQLite database file (relative to project root)
DB_PATH=./database/restore.db

# How often to run the automatic backup job, in cron syntax (default: every 6 hours)
BACKUP_CRON=0 */6 * * *

# Directory where automatic backups are written
BACKUP_DIR=./backups
